# Copy to .env and fill in. NEVER commit .env.

# --- Robinhood Crypto API ---
# Create an API key at robinhood.com (web) -> Account -> Crypto -> "Crypto API".
# Register the PUBLIC key printed by scripts/generate_keypair.py; paste the
# private key (base64 seed) below and the API key Robinhood gives you.
RH_API_KEY=
RH_PRIVATE_KEY_B64=
RH_API_BASE_URL=https://trading.robinhood.com

# --- Alpaca (paper broker + market data; free at alpaca.markets) ---
# REQUIRED for stocks (BROKER=alpaca). Free paper keys: alpaca.markets ->
# Paper Trading -> API Keys. Crypto (BROKER=sim) runs keyless without these.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# --- Robinhood Agentic MCP (live equities, Phase 4) ---
RH_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Anthropic (LLM advisor, Phase 3+) ---
ANTHROPIC_API_KEY=

# --- Dashboard ---
DASHBOARD_TOKEN=change-me-to-a-long-random-string
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Notifications (Phase 5; free, optional) ---
# ntfy.sh topic (pick something unguessable, e.g. rhbot-$(openssl rand -hex 8)).
# Subscribe to it in the ntfy phone app. Leave blank to disable push.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh
# Which events push: halt,watchdog,error,reconcile,daily  (also: fills,engine)
NOTIFY_EVENTS=halt,watchdog,error,reconcile,daily
# Min seconds between repeats of the same alert.
NOTIFY_MIN_INTERVAL_S=900
# Optional SMTP URL for email alerts, e.g. smtp+tls://user:pass@smtp.host:587
SMTP_URL=
ALERT_EMAIL_TO=

# --- Logging (botcore.serve) ---
# LOG_DIR blank -> <repo>/logs. paper.log rotates at LOG_MAX_MB, keeps LOG_BACKUPS.
LOG_DIR=
LOG_MAX_MB=5
LOG_BACKUPS=5

# --- Trading mode & money caps ---
# paper = simulated fills on live quotes (default). live = real orders.
BOT_MODE=paper
# Which broker: sim (keyless crypto paper) | alpaca (stocks or crypto; needs keys)
BROKER=alpaca
# Starting virtual equity for the sim broker.
PAPER_START_EQUITY=100000
# Hard ceiling (USD) on bot-controlled notional in LIVE mode. Stays 0 until YOU raise it.
LIVE_MAX_USD=0
# Per-order ceiling (USD). 0 = no cap (fine for paper); set to e.g. 20 for the first live phase.
MAX_TRADE_USD=0
